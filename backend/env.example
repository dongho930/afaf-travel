# 한국관광공사 OpenAPI (공공데이터포털에서 발급)
TOUR_API_KEY=

# Gemini API (aistudio.google.com/apikey 에서 무료로 발급, 신용카드 불필요)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 카카오맵 REST API 키 (서버측 길찾기 호출용, 개발자.kakao.com 에서 발급)
KAKAO_REST_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 실제 API 키 발급 전에는 true로 두면 경기도 목업 데이터로 동작합니다.
USE_MOCK_DATA=true
